# ========================================================
# ShareNest Environment Configuration Example
# ========================================================

# Server Configuration (copy to server/.env)
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sharenest
JWT_SECRET=your_secure_jwt_secret_change_in_production
CLIENT_URL=http://localhost:5174
NODE_ENV=development

# Frontend Configuration (optional, Vite proxies /api to port 5000)
VITE_API_URL=/api
